# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
.venv/

# Build artifacts
build/
dist/
*.spec
*.exe
*.zip
*.pem

# Built frontend (generated from app/ during build)
api/frontend_dist/

# IDE — commit shared editor settings only
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
app/.vscode/*
!app/.vscode/settings.json
*.swp
*.swo

# Cursor — commit shared rules/hooks, ignore local state
.cursor/hooks/state/
.cursor/**/*.log

# Logs
logs/
*.log

# Local config (may contain sensitive data)
config.ini
license.key

# Runtime state JSON if copied to repo root during local dev
/orders.json
/total_filament.json
/library.json
/queue.json
/printers.json
/ejection_codes.json
/ejection_paused.json
/logging_settings.json
/print_history.json
/default_settings.json

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak

# Node.js
node_modules/
*.local
.env
.nitro
.tanstack
.wrangler
.output
.vinxi
dist-ssr/
nul
